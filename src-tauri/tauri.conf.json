{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovaMP",
  "version": "0.4.3",
  "identifier": "com.andrei.novamp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NovaMP",
        "width": 1280,
        "height": 720,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDNkRFQzY0MzMwQkFBQUEKUldTcXFnc3paT3h0ekIvVVpiRW9JNHRRakwrRWpyYnUwd1ZNRE5DckpydytQR0JBSnlHQVp0QXoK",
      "endpoints": [
        "https://github.com/goguldelaposta/novamp/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}